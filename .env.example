VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ---- Edge function (send-email) secrets ----
# Set via:  supabase secrets set SMTP_HOST=...   (do NOT commit real values)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=replace-with-real-password
# SMTP_ENCRYPTION=tls         # none | ssl | tls
# SMTP_FROM=no-reply@yourdomain.com
# SMTP_FROM_NAME=Haratrading
# SMTP_REPLY_TO=support@yourdomain.com
# BRAND_NAME=Haratrading
# BRAND_URL=https://www.haratrading.com
# BRAND_LOGO_URL=https://www.haratrading.com/logo.png
# BRAND_COLOR=#f59e0b
# SUPPORT_EMAIL=support@yourdomain.com
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
